+static int reload_sources(UNUSED const char* function_name,
+                          amxc_var_t* args,
+                          amxc_var_t* ret) {
+    bool onoff = GET_BOOL(args, "onoff");
+    int rv = 0;
+
+    when_failed_trace(align_config(args, ret), exit, ERROR, "align chrony config failed");
+    rv = chronyc_cmd_onoffline(onoff);
+    if(onoff) {
+        rv = chronyc_cmd_reload();
+        if(rv == 0) {
+            /* If it failed to reload the sources, we most probably need to
+             * reload the config from scratch. */
+            SAH_TRACEZ_INFO(ME, "(Re)applying the chronyd config");
+            apply_config(true);
+        }
+    }
+
+exit:
+    return !rv;
 }
 
